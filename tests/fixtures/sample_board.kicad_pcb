    (fp_line (start 2.5 2.5) (end -2.5 2.5) (layer "F.CrtYd") (width 0.05))
    (fp_line (start -2.5 2.5) (end -2.5 -2.5) (layer "F.CrtYd") (width 0.05))
    (pad "1" smd rect (at -1.0 -1.0 0) (size 0.4 0.3) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "VCC") (uuid "u3-p1"))
    (pad "2" smd rect (at 1.0 -1.0 0) (size 0.4 0.3) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND") (uuid "u3-p2"))
    (pad "4" smd rect (at 1.05 1.0 0) (size 0.4 0.3) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SPI_CLK") (uuid "u3-p4"))
  )

  (footprint "Resistor_SMD:R_0603_1608Metric" (layer "F.Cu")
