    (fp_line (start -0.9 0.5) (end -0.9 -0.5) (layer "F.CrtYd") (width 0.05))
    (pad "1" smd roundrect (at -0.75 0 0) (size 0.9 0.95) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SPI_CLK") (uuid "r8-p1"))
    (pad "2" smd roundrect (at 0.75 0 0) (size 0.9 0.95) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "SPI_MISO") (uuid "r8-p2"))
