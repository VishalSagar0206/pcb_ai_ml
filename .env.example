# === KiCad ===
# Path to kicad-cli executable. If unset, the tool searches PATH for "kicad-cli".
KICAD_CLI_PATH=kicad-cli
# Timeout (seconds) for kicad-cli DRC invocation.
KICAD_DRC_TIMEOUT_S=120

# === LLM provider (OpenAI-compatible endpoint, e.g. self-hosted vLLM/LiteLLM proxy) ===
CAF_MODEL_PROVIDER=vllm
CAF_MODEL_BASE_URL=https://your-llm-gateway.example.org/v1
CAF_MODEL_API_KEY=sk-changeme
# Model used for full diagnosis/reasoning calls.
CAF_MODEL_ANALYSIS=nemotron3-super-120b
# Model used for general-purpose calls (defaults to CAF_MODEL_ANALYSIS if unset).
CAF_MODEL_GENERAL=nemotron3-super-120b
# Lightweight/fast model for cheap classification-style calls (optional).
CAF_MODEL_FAST=fast-classify

# === Gemini quick start (alternative provider -- for testing with your own
# free Google Gemini API key instead of the CAF_MODEL_* gateway above) ===
# Get a free key in ~30 seconds, no credit card needed:
#   https://aistudio.google.com/apikey
# To use it: set CAF_MODEL_PROVIDER=gemini below and fill in GEMINI_API_KEY.
# This does NOT touch/require the CAF_MODEL_* settings above -- both can
# stay configured in the same .env; whichever CAF_MODEL_PROVIDER value is
# active decides which one is actually used. Leave CAF_MODEL_PROVIDER=vllm
# (or whatever it already is) if you don't want to switch.
# CAF_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# Optional -- defaults to a current Gemini flash-tier model if left unset.
# Check https://ai.google.dev/gemini-api/docs/models for the latest names.
GEMINI_MODEL=
# Optional -- only needed if routing through a custom Gemini-compatible
# proxy; defaults to Google's own OpenAI-compatibility endpoint.
GEMINI_BASE_URL=

# LLM sampling parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_S=180

# === Observability (optional Langfuse tracing) ===
CAF_LANGFUSE_ENABLED=false
CAF_LANGFUSE_HOST=http://localhost:13000
CAF_LANGFUSE_PUBLIC_KEY=
CAF_LANGFUSE_SECRET_KEY=

# === Retrieval / RAG ===
KNOWLEDGE_DIR=./data/knowledge
DATASHEET_DIR=./data/datasheets
RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.05
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# === Severity policy ===
SEVERITY_POLICY_VERSION=1.0

# === Context limits ===
MAX_PCB_CONTEXT_OBJECTS=40
MAX_KNOWLEDGE_CHUNKS=8

# === Logging ===
LOG_LEVEL=INFO

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Frontend / demo / research-reference data (paths relative to cwd) ===
DEMO_DIR=./data/demo
SAMPLES_DIR=./data/samples
RESULTS_DIR=./results
PCB_QA_REFERENCE_DIR=./pcb_qa-4FEE
