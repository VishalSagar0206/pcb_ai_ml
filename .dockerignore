# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Version control / editors ---
.git/
.gitignore
.vscode/
.idea/

# --- Frontend (built separately by frontend/Dockerfile) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Secrets / local env ---
.env
